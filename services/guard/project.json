{
  "name": "@lmp/guard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/guard/src",
  "tags": ["type:service", "zone:gate", "lang:py"],
  "targets": {
    "lint": {
      "command": "uv run ruff check services/guard && uv run lint-imports --config services/guard/pyproject.toml",
      "cache": true
    },
    "test": {
      "command": "uv run --package lmp-guard pytest services/guard/tests",
      "cache": true
    }
  }
}
