{
  "name": "@lmp/docai",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/docai/src",
  "tags": ["type:service", "zone:masked", "lang:py"],
  "targets": {
    "lint": {
      "command": "uv run ruff check services/docai && uv run lint-imports --config services/docai/pyproject.toml",
      "cache": true
    },
    "test": {
      "command": "uv run --package lmp-docai pytest services/docai/tests",
      "cache": true
    }
  }
}
