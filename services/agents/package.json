    "@ai-sdk/openai-compatible": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@temporalio/activity": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/vercel-ai-sdk": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "ai": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lmp/testing": "workspace:*",
    "@temporalio/testing": "catalog:",
    "testcontainers": "catalog:"
  },
  "nx": {
