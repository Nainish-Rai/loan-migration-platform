// Builds src/ to dist/ with tsc. Tests are compiled by Vitest with SWC, so they stay out of this file.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/platform-node"
    }
  ]
}
